HOST=0.0.0.0
PORT=3000
BRAVE_SEARCH_API_KEY=
# Brave Search APIの請求・無料枠保護。必要に応じて管理者が引き下げる。
BRAVE_SEARCH_MONTHLY_LIMIT=900
BRAVE_SEARCH_ALERT_AT=800
BRAVE_SEARCH_DAILY_LIMIT=100
BRAVE_SEARCH_PER_MINUTE_LIMIT=10
BRAVE_SEARCH_MIN_INTERVAL_MS=1000
POS_DATABASE_PATH=/var/lib/event-pos/event-pos.sqlite
PRINTER_HOST_URL=http://host.docker.internal:4318
