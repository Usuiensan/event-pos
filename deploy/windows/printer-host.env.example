# このファイルを printer-host.env として複製し、実機名とNodeの場所を確認する。
NODE_ENV=production
NODE_EXE=C:\Program Files\nodejs\node.exe
PRINTER_BACKEND=windows-spooler
PRINTER_NAME=EPSON TM-T70II Receipt
PRINTER_STATUS_BACKEND=opos
PRINTER_OPOS_LOGICAL_NAME=TM-T70II
PRINTER_OPOS_CLAIM_TIMEOUT_MS=3000
HOST=127.0.0.1
PORT=4318
PRINTER_STATUS_TIMEOUT_MS=1000
